# Copy to .env and fill in. Never commit your real .env.

# --- Required -----------------------------------------------------------
# Random string, 16+ characters. Needed to add/edit items and for the discovery job.
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=

# --- App ------------------------------------------------------------------
PORT=8080
# Public address of this app, used for links in notifications (optional).
PUBLIC_URL=
# true = anyone who can reach the app can view prices. false = viewing needs the admin token too.
PUBLIC_READ=true
# Everything is converted to this currency for comparison.
BASE_CURRENCY=NZD
# Used if the live FX lookup fails: 1 unit of each currency in BASE_CURRENCY.
FX_FALLBACK=USD=1.70,AUD=1.10

# --- changedetection.io (optional) ---------------------------------------
# Base URL as seen from this container, and the key from changedetection Settings -> API.
CHANGEDETECTION_URL=
CHANGEDETECTION_API_KEY=
# Watches tagged "<prefix><item-id>" (e.g. pw:my-monitor) are linked to that item.
CHANGEDETECTION_TAG_PREFIX=pw:
SYNC_INTERVAL_MINUTES=30

# --- PriceSpy (optional) -------------------------------------------------
PRICESPY_ENABLED=true
# pricespy.co.nz, pricespy.co.uk, prisjakt.nu, ... (same page format)
PRICESPY_BASE_URL=https://pricespy.co.nz
PRICESPY_INTERVAL_HOURS=6
PRICESPY_DELAY_SECONDS=3

# --- ntfy notifications (optional) ---------------------------------------
# e.g. https://ntfy.example.com (use https if your proxy redirects http -> https)
NTFY_URL=
NTFY_TOPIC=pricewatch
NTFY_TOKEN=

# --- Alerts ---------------------------------------------------------------
ALERT_DROP_PERCENT=5
ALERT_DISCOVERY_BEAT_PERCENT=5

# --- Discovery job (optional, see discovery/README.md) --------------------
# Token from `claude setup-token`. Uses your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
DISCOVERY_REGION=New Zealand
DISCOVERY_INTERVAL_HOURS=24
